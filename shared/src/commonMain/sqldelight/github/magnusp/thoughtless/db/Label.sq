CREATE TABLE IF NOT EXISTS Label (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    color TEXT
);

CREATE TABLE IF NOT EXISTS TaskLabel (
    task_id TEXT NOT NULL REFERENCES Task(id) ON DELETE CASCADE,
    label_id TEXT NOT NULL REFERENCES Label(id) ON DELETE CASCADE,
    PRIMARY KEY (task_id, label_id)
);

selectAllLabels:
SELECT * FROM Label ORDER BY name ASC;

selectLabelById:
SELECT * FROM Label WHERE id = ?;

selectLabelsForTask:
SELECT l.* FROM Label l
INNER JOIN TaskLabel tl ON l.id = tl.label_id
WHERE tl.task_id = ?
ORDER BY l.name ASC;

insertLabel:
INSERT OR REPLACE INTO Label(id, name, color)
VALUES (?, ?, ?);

deleteLabel:
DELETE FROM Label WHERE id = ?;

insertTaskLabel:
INSERT OR IGNORE INTO TaskLabel(task_id, label_id)
VALUES (?, ?);

deleteTaskLabel:
DELETE FROM TaskLabel
WHERE task_id = ? AND label_id = ?;

clearTaskLabels:
DELETE FROM TaskLabel
WHERE task_id = ?;
