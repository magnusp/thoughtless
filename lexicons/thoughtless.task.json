{
  "lexicon": 1,
  "id": "thoughtless.task",
  "defs": {
    "main": {
      "type": "record",
      "description": "A task item in Thoughtless",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "title",
          "status",
          "createdAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "status": {
            "type": "string",
            "knownValues": [
              "TODO",
              "IN_PROGRESS",
              "DONE",
              "CANCELLED"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "dueDate": {
            "type": "integer"
          },
          "projectId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          },
          "completedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
