CREATE TABLE IF NOT EXISTS Task (
    id TEXT NOT NULL PRIMARY KEY,
    project_id TEXT REFERENCES Project(id) ON DELETE SET NULL,
    title TEXT NOT NULL,
    description TEXT,
    status TEXT NOT NULL DEFAULT 'TODO',
    priority INTEGER NOT NULL DEFAULT 0,
    due_date INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    completed_at INTEGER
);

selectAllTasks:
SELECT * FROM Task ORDER BY created_at DESC;

selectTasksByProject:
SELECT * FROM Task WHERE project_id = ? ORDER BY created_at DESC;

selectInboxTasks:
SELECT * FROM Task WHERE project_id IS NULL ORDER BY created_at DESC;

selectTaskById:
SELECT * FROM Task WHERE id = ?;

insertTask:
INSERT OR REPLACE INTO Task(
    id, project_id, title, description, status, priority, due_date, created_at, updated_at, completed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTaskStatus:
UPDATE Task
SET status = ?, completed_at = ?, updated_at = ?
WHERE id = ?;

updateTask:
UPDATE Task
SET project_id = ?, title = ?, description = ?, status = ?, priority = ?, due_date = ?, updated_at = ?, completed_at = ?
WHERE id = ?;

deleteTask:
DELETE FROM Task WHERE id = ?;

deleteTasksByProject:
DELETE FROM Task WHERE project_id = ?;

countTasks:
SELECT COUNT(*) FROM Task;
