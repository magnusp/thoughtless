{
  "lexicon": 1,
  "id": "thoughtless.milestone",
  "defs": {
    "main": {
      "type": "record",
      "description": "A project milestone in Thoughtless",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "projectId",
          "title",
          "createdAt"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "targetDate": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
